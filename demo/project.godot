; Engine configuration file.
; It's best edited using the editor UI and not directly.

config_version=5

[application]

config/name="godot-ajantv2 demo"
run/main_scene="res://scenes/ajantv2_demo.tscn"
config/features=PackedStringArray("4.6")

[native_extensions]

paths=["res://addons/godot-ajantv2/godot-ajantv2.gdextension"]

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
