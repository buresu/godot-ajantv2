[configuration]
entry_symbol = "godot_ajantv2_init"
compatibility_minimum = "4.3"
reloadable = false

[libraries]
windows.debug.x86_64   = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.windows.debug.x86_64.dll"
windows.release.x86_64 = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.windows.release.x86_64.dll"
windows.debug.arm64    = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.windows.debug.arm64.dll"
windows.release.arm64  = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.windows.release.arm64.dll"

macos.debug.x86_64     = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.macos.debug.x86_64.dylib"
macos.release.x86_64   = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.macos.release.x86_64.dylib"
macos.debug.arm64      = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.macos.debug.arm64.dylib"
macos.release.arm64    = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.macos.release.arm64.dylib"

linux.debug.x86_64     = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.linux.debug.x86_64.so"
linux.release.x86_64   = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.linux.release.x86_64.so"
linux.debug.arm64      = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.linux.debug.arm64.so"
linux.release.arm64    = "res://addons/godot-ajantv2/bin/libgodot-ajantv2.linux.release.arm64.so"
